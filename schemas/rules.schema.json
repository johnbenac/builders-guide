{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rule registry",
  "description": "rules.json: every rule of the guides with machine fields. Generated by tools/build_rules.py; do not edit by hand.",
  "type": "object",
  "required": [
    "format",
    "version",
    "count",
    "rules"
  ],
  "properties": {
    "format": {
      "const": "rules/1"
    },
    "version": {
      "type": "string"
    },
    "count": {
      "type": "integer"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "applies_to",
          "statement",
          "rationale",
          "how_to_check",
          "automated",
          "fix_hint",
          "examples",
          "related",
          "parameters",
          "extension"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[BDFX]-\\d+[a-z]?$"
          },
          "level": {
            "enum": [
              "required",
              "recommended"
            ]
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "building",
                "room",
                "material",
                "furniture",
                "package",
                "submission"
              ]
            }
          },
          "guide": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 5
          },
          "rationale": {
            "type": "string",
            "minLength": 5
          },
          "how_to_check": {
            "type": "object",
            "required": [
              "tool",
              "command",
              "method"
            ],
            "properties": {
              "tool": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "command": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "method": {
                "type": "string"
              }
            }
          },
          "automated": {
            "type": "boolean"
          },
          "fix_hint": {
            "type": "string",
            "minLength": 5
          },
          "examples": {
            "type": "object",
            "required": [
              "good",
              "bad"
            ],
            "properties": {
              "good": {
                "type": "string"
              },
              "bad": {
                "type": "string"
              }
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[BDFX]-\\d+[a-z]?$"
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "profile parameters the rule uses, by dotted name"
          },
          "extension": {
            "type": [
              "string",
              "null"
            ],
            "description": "extension that must be enabled in the profile for the rule to apply, or null for a core rule"
          }
        }
      }
    }
  },
  "$comment": "SPDX-License-Identifier: Apache-2.0"
}
